# Copy this file to .env, then set your API key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Server settings
TRANSFLOW_HOST=127.0.0.1
TRANSFLOW_PORT=8787
TRANSFLOW_FRONTEND_ORIGIN=http://127.0.0.1:5173
TRANSFLOW_PREFETCH_PAGES=5
TRANSFLOW_MAX_WORKERS=2
TRANSFLOW_DATA_DIR=runtime

# Set to mock for local UI testing without making model requests.
TRANSFLOW_LLM_MODE=openai

