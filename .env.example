# Copy this file to .env, then set your API key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Server settings
TRANSFLOW_HOST=127.0.0.1
TRANSFLOW_PORT=8787
TRANSFLOW_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Independent browser/translation service; does not load PDF layout models.
TRANSFLOW_WEB_PORT=8788
TRANSFLOW_WEB_BACKEND_URL=http://127.0.0.1:8788
TRANSFLOW_PREFETCH_PAGES=5
TRANSFLOW_MAX_WORKERS=2
TRANSFLOW_SOURCE_LANGUAGE=en
TRANSFLOW_LLM_QPS=4
TRANSFLOW_LLM_WORKERS=4
TRANSFLOW_LLM_MAX_IN_FLIGHT=4
TRANSFLOW_LLM_MAX_ATTEMPTS=3
TRANSFLOW_LLM_TIMEOUT_SECONDS=120
TRANSFLOW_KEEP_JOB_FILES=false
TRANSFLOW_TRANSLATE_TABLE_TEXT=false
TRANSFLOW_DATA_DIR=runtime

# Set to mock for local UI testing without making model requests.
TRANSFLOW_LLM_MODE=openai

# Optional model prices (USD per million tokens); leave blank if unknown.
TRANSFLOW_WEB_INPUT_USD_PER_MILLION=
TRANSFLOW_WEB_OUTPUT_USD_PER_MILLION=

# Ark only: default keeps the provider thinking mode; disabled speeds up translation.
TRANSFLOW_WEB_THINKING=disabled
